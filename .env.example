# Copy this to .env.local for local work, and set the same NEXT_PUBLIC_ values
# on Vercel. Nothing here belongs in git — see .gitignore.

# ─── scripts only (deploy, tests) ────────────────────────────────────────────
# Signs the transactions scripts/deploy.mjs and test/crewpay.test.mjs send.
# scripts/deploy.mjs generates a throwaway one for testnet; it refuses to
# generate one for mainnet, because a mainnet deploy spends real money from a
# wallet you must already control.
DEPLOYER_PRIVATE_KEY=
CREWPAY_NETWORK=testnet

# ─── written by scripts/deploy.mjs ───────────────────────────────────────────
CREWPAY_ADDRESS_TESTNET=
CREWPAY_BLOCK_TESTNET=
CREWPAY_ADDRESS_MAINNET=
CREWPAY_BLOCK_MAINNET=

# ─── inlined into the browser bundle at build time ───────────────────────────
# Public addresses. Never put a private key or an RPC secret behind a
# NEXT_PUBLIC_ name — everything with that prefix ships to the visitor.
NEXT_PUBLIC_CREWPAY_ADDRESS_TESTNET=
NEXT_PUBLIC_CREWPAY_BLOCK_TESTNET=
NEXT_PUBLIC_CREWPAY_ADDRESS_MAINNET=
NEXT_PUBLIC_CREWPAY_BLOCK_MAINNET=

# testnet | mainnet — which network the app opens on. Links always carry their
# own network, so this only decides the starting point.
NEXT_PUBLIC_DEFAULT_NETWORK=testnet
